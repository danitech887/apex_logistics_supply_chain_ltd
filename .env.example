# ==============================================================================
# Apex Logistics & Supply Chain Ltd - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Django Backend Core
# ------------------------------------------------------------------------------
DJANGO_ENVIRONMENT=development
DJANGO_SECRET_KEY=django-insecure-apex-super-secret-production-key-replace-me-12345
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,web,0.0.0.0

# ------------------------------------------------------------------------------
# PostgreSQL Database (Multi-Schema Namespace Configuration)
# ------------------------------------------------------------------------------
POSTGRES_DB=apex_logistics_db
POSTGRES_USER=apex_admin
POSTGRES_PASSWORD=apex_secure_pass_2026
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_SEARCH_PATH=auth_core,hr_payroll,finance,fleet_ops,warehouse_crm,public

# ------------------------------------------------------------------------------
# Redis & Celery Message Broker
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ------------------------------------------------------------------------------
# Security & JWT Authentication
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=apex-jwt-auth-token-super-secret-sign-key-98765
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_ALGORITHM=HS256

# ------------------------------------------------------------------------------
# CORS & Frontend Origins
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# Frontend Environment Variables (Vite)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_TITLE=Apex Logistics & Supply Chain Ltd - Enterprise ERP
